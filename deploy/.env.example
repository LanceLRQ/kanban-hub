# 复制为 .env 后按需修改

# 容器的运行身份：填宿主机上 `id -u` 和 `id -g` 的结果，保证写出的文件归你所有
PUID=1000
PGID=1000
# 新建文件的权限掩码；需要同组用户可写时改为 002
UMASK=022

# 管理员密码（必填）。这是唯一来源：修改后重启，所有已登录的会话都会失效
KH_ADMIN_PASSWORD=

# 监听地址与端口；放在 HTTPS 反向代理之后时，把 KH_BIND 改为 127.0.0.1
KH_BIND=0.0.0.0
KH_PORT=28970

# 接入引导里给 agent 的服务地址，例如 http://192.168.1.10:28970；留空则从请求的 Host 推断
KH_PUBLIC_URL=

# 项目多少天没有活动算停滞
KH_STALE_DAYS=7

TZ=Asia/Shanghai

# 构建镜像时使用的代理（可选）
HTTP_PROXY=
HTTPS_PROXY=
